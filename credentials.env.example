# Copy to ~/.flight-fare-scanner/credentials.env and chmod 600.
# Never commit this file.

# ---------------------------------------------------------------- required
# ONE data provider key is required - whichever one your config selects.

# --- provider: google_flights (the default)
# Google Flights data via SerpApi. Google has no official flight API, so this
# goes through SerpApi. Sign up at https://serpapi.com/users/sign_up for a
# self-serve key with 100 free searches/month.
export SERPAPI_KEY="your-serpapi-key"

# --- provider: amadeus
# Official GDS API - https://developers.amadeus.com/register
# Create an app, then copy its API Key / API Secret.
# A test-environment key does NOT work against production and vice versa.
# export AMADEUS_CLIENT_ID="your-api-key"
# export AMADEUS_CLIENT_SECRET="your-api-secret"

# Note: Skyscanner is not supported. Its Flights API is partner-gated with no
# self-serve signup, so it cannot be enabled from a personal machine.

# ---------------------------------------------------------------- optional
# Email push. Only needed when notify.email.enabled is true.
# Use an APP-SPECIFIC password, not your account password - Gmail, Outlook,
# QQ, 163 and iCloud all reject the normal password for SMTP.
#   Gmail    smtp.gmail.com      587 starttls   (needs 2FA + app password)
#   Outlook  smtp.office365.com  587 starttls
#   QQ       smtp.qq.com         465 ssl        (password = 授权码)
#   163      smtp.163.com        465 ssl        (password = 授权码)
#   iCloud   smtp.mail.me.com    587 starttls
export SMTP_USER="you@example.com"
export SMTP_PASSWORD="your-app-specific-password"
# Only needed if you left notify.email.host blank in the config.
# export SMTP_HOST="smtp.example.com"

# DingTalk custom robot - entirely optional, the skill does not require it.
# Group -> Settings -> Robots -> Add -> Custom.
# export DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=xxxx"
# Set this only if you chose "Signing" (加签) as the robot's security setting.
# export DINGTALK_SECRET="SECxxxxxxxx"
